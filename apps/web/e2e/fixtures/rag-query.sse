data: {"type":"data-rag-trace","id":"trace","data":{"settings":{"topK":5,"minSimilarity":0.5,"pool":20,"filter":{},"methods":{"hyde":false,"multiQuery":false,"hybrid":true,"rerank":true}},"vector":[{"query":"RAG（Retrieval-Augmented Generation、検索拡張生成）は、大規模言語モデルに質問する前に、外部の文書から関連する部分を検索して、その内容を根拠として回答を生成する方式である。モデルが学習時に覚えた知識だけに頼らず、手元の文書を根拠にできる点が最大の特徴である。","candidates":[{"chunk":{"id":"3e40e887390d058b","documentId":"eval:01-rag-overview.md","documentTitle":"RAG の全体像","ordinal":0,"headingPath":["RAG の全体像"],"page":null,"body":"RAG（Retrieval-Augmented Generation、検索拡張生成）は、大規模言語モデルに質問する前に、外部の文書から関連する部分を検索して、その内容を根拠として回答を生成する方式である。モデルが学習時に覚えた知識だけに頼らず、手元の文書を根拠にできる点が最大の特徴である。"},"score":1,"similarity":1}]}],"fullText":[],"fused":[],"rerank":{"status":"disabled"},"final":[],"stages":[{"stage":"hyde","status":"skipped","durationMs":0,"detail":"無効"},{"stage":"multi-query","status":"skipped","durationMs":0,"detail":"無効"},{"stage":"vector-search","status":"done","durationMs":0}]}}

