{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"env": ["AI_TEST_RUN_MODE"],
			"outputs": ["coverage/**"]
		},
		"//#typecheck": {
			"outputs": []
		},
		"//#test": {
			"env": ["AI_TEST_RUN_MODE"],
			"outputs": ["coverage/**"]
		}
	}
}
