# Copy to .env.local and fill in only what you need. Never put secrets in NEXT_PUBLIC_* variables.

# AI runtime
# Run mode: mock / local / live (default: local).
AI_RUN_MODE=
# Run-mode override inside the test runner (default: mock).
AI_TEST_RUN_MODE=
# Default provider for live mode: anthropic / openai / azure / google (default: anthropic).
AI_LIVE_PROVIDER=
# Per-purpose model IDs (default: the model catalog's defaults; unknown IDs fail at startup).
AI_MODEL_CHAT=
AI_MODEL_STRUCTURED=
AI_MODEL_EMBEDDING=
AI_MODEL_JUDGE=
# Set to 1 to record cassettes (local or live mode only).
AI_RECORD=

# Local model provider
# Ollama server URL (default: http://127.0.0.1:11434).
OLLAMA_BASE_URL=

# Live model providers (required only for the selected live provider)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Azure OpenAI needs both the key and the resource name.
AZURE_API_KEY=
AZURE_RESOURCE_NAME=
GOOGLE_GENERATIVE_AI_API_KEY=

# External tools
# Web search tool (not needed in mock mode).
TAVILY_API_KEY=

# Agent limits
# Maximum loop steps (default: 10).
AGENT_MAX_STEPS=
# Maximum total tokens per run (default: 50000).
AGENT_MAX_TOTAL_TOKENS=
# Maximum run duration in milliseconds (default: 120000).
AGENT_MAX_DURATION_MS=
# Per-tool-call timeout in milliseconds (default: 15000).
AGENT_TOOL_TIMEOUT_MS=

# Request rate limiting
# Maximum chat requests per window (default: 20).
CHAT_RATE_LIMIT_MAX=
# Rate-limit window length in seconds (default: 60).
CHAT_RATE_LIMIT_WINDOW_SECONDS=

# Postgres and pgvector (local Compose services)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host port mapped to the Postgres container.
POSTGRES_PORT=

# Langfuse client
# Langfuse server URL used by the OpenTelemetry exporter.
LANGFUSE_BASE_URL=
# Project API keys created in the Langfuse web UI.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse local services (Compose)
# Host port mapped to the Langfuse web UI.
LANGFUSE_PORT=
# Random secrets for Langfuse authentication and encryption.
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
# Langfuse database created inside the Postgres service.
LANGFUSE_DB_NAME=
# Credentials for the Langfuse ClickHouse, Redis, and MinIO services.
LANGFUSE_CLICKHOUSE_USER=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_AUTH=
LANGFUSE_MINIO_ROOT_USER=
LANGFUSE_MINIO_ROOT_PASSWORD=
